set -euo pipefail

report=${FRDM_IMX95_WAVE6_REPORT:-"$PWD/frdm-imx95-wave6-smoke.json"}
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/frdm-imx95-wave6-smoke.XXXXXX")
trap 'rm -rf -- "$work_dir"' EXIT

find_role() {
  local codec=$1
  local role=$2
  local device
  local identity
  local output_formats
  local capture_formats

  for device in /dev/video*; do
    [ -e "$device" ] || continue
    identity=$(v4l2-ctl --device="$device" --all 2>/dev/null || true)
    if ! grep -Fqi "$FRDM_IMX95_WAVE6_DRIVER" <<<"$identity"; then
      continue
    fi
    output_formats=$(v4l2-ctl --device="$device" --list-formats-out 2>/dev/null || true)
    capture_formats=$(v4l2-ctl --device="$device" --list-formats 2>/dev/null || true)

    if [ "$role" = encoder ] &&
      grep -Fq "'$codec'" <<<"$capture_formats" &&
      grep -Fq "'NV12'" <<<"$output_formats"; then
      printf '%s\n' "$device"
      return 0
    fi
    if [ "$role" = decoder ] &&
      grep -Fq "'$codec'" <<<"$output_formats" &&
      grep -Fq "'NV12'" <<<"$capture_formats"; then
      printf '%s\n' "$device"
      return 0
    fi
  done
  return 1
}

run_codec() {
  local codec=$1
  local label=$2
  local encoder
  local decoder
  local encoded
  local decoded

  encoder=$(find_role "$codec" encoder) ||
    {
      echo "no Wave6 $label encoder was found" >&2
      return 1
    }
  decoder=$(find_role "$codec" decoder) ||
    {
      echo "no Wave6 $label decoder was found" >&2
      return 1
    }

  encoded="$work_dir/$label.bin"
  decoded="$work_dir/$label.nv12"

  v4l2-ctl --device="$encoder" \
    --set-fmt-video-out=width="$FRDM_IMX95_WAVE6_WIDTH",height="$FRDM_IMX95_WAVE6_HEIGHT",pixelformat=NV12 \
    --set-fmt-video=width="$FRDM_IMX95_WAVE6_WIDTH",height="$FRDM_IMX95_WAVE6_HEIGHT",pixelformat="$codec" \
    --stream-out-mmap \
    --stream-mmap \
    --stream-from="$work_dir/input.nv12" \
    --stream-to="$encoded" \
    --stream-count=1
  test -s "$encoded"

  v4l2-ctl --device="$decoder" \
    --set-fmt-video-out=width="$FRDM_IMX95_WAVE6_WIDTH",height="$FRDM_IMX95_WAVE6_HEIGHT",pixelformat="$codec" \
    --set-fmt-video=width="$FRDM_IMX95_WAVE6_WIDTH",height="$FRDM_IMX95_WAVE6_HEIGHT",pixelformat=NV12 \
    --stream-out-mmap \
    --stream-mmap \
    --stream-from="$encoded" \
    --stream-to="$decoded" \
    --stream-count=1
  test "$(stat -c %s "$decoded")" -eq "$FRDM_IMX95_WAVE6_FRAME_BYTES"

  jq -n \
    --arg codec "$label" \
    --arg decoder "$decoder" \
    --arg driver "$FRDM_IMX95_WAVE6_DRIVER" \
    --arg encoder "$encoder" \
    --argjson encodedBytes "$(stat -c %s "$encoded")" \
    --argjson decodedBytes "$FRDM_IMX95_WAVE6_FRAME_BYTES" \
    --argjson height "$FRDM_IMX95_WAVE6_HEIGHT" \
    --argjson width "$FRDM_IMX95_WAVE6_WIDTH" \
    '{
      accepted: true,
      codec: $codec,
      driver: $driver,
      encoder: $encoder,
      decoder: $decoder,
      encodedBytes: $encodedBytes,
      decodedBytes: $decodedBytes,
      width: $width,
      height: $height
    }'
}

dd if=/dev/zero of="$work_dir/input.nv12" \
  bs="$FRDM_IMX95_WAVE6_FRAME_BYTES" count=1 status=none
run_codec H264 h264 >"$work_dir/h264.json"
run_codec HEVC h265 >"$work_dir/h265.json"

jq -n \
  --slurpfile h264 "$work_dir/h264.json" \
  --slurpfile h265 "$work_dir/h265.json" \
  '{
    accepted: true,
    userspace: "v4l2-ctl",
    codecs: {
      h264: $h264[0],
      h265: $h265[0]
    }
  }' >"$report"

echo "FRDM-i.MX95 Wave6 smoke accepted: $report"
